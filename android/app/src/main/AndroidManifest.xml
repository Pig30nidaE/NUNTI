<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <queries><intent><action android:name="android.intent.action.TTS_SERVICE" /></intent><intent><action android:name="ai.pleos.playground.intent.action.NAVI_START" /></intent></queries>
    <application android:label="눈티 · 여정 아바타" android:icon="@drawable/ic_nunti" android:allowBackup="false" android:networkSecurityConfig="@xml/studio_network_security" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:supportsRtl="true">
        <uses-library android:name="android.car" android:required="false" />
        <activity android:name=".studio.AvatarStudioActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />
        <activity android:name=".journey.JourneyActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <service android:name=".journey.JourneyService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <!-- The launcher delegates to the active companion. Generation itself remains parked-only. -->
        <activity android:name=".MainActivity" android:exported="true">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
