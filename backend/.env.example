# Generate a separate random token per installation/principal. Never commit real tokens.
# Example shape only; the server rejects an empty token map.
NUNTI_AUTH_TOKENS={}
NUNTI_DB_PATH=data/nunti.sqlite3
NUNTI_SYNC_ENABLED=false
NUNTI_ENABLE_MOCKS=false
NUNTI_RETENTION_DAYS=30
# Development: bind 127.0.0.1. Production: TLS-terminating reverse proxy on a private hop.
NUNTI_REQUIRE_HTTPS=true

# Character generation v2: API startup never runs a generation worker.
NUNTI_GENERATION_MODE=DISABLED
NUNTI_GENERATION_PIPELINE=OPENAI_ELEVEN
NUNTI_CHARACTER_DB_PATH=data/characters-v2.sqlite3
NUNTI_CHARACTER_MEDIA_PATH=data/characters-v2-media
# OFFLINE_FIXTURE uses existing media with an explicit fixture notice.
# NUNTI_FIXTURE_PNG=/absolute/path/to/recipe-coastal-001.png
# NUNTI_FIXTURE_MANIFEST=/absolute/path/to/journey-dynamic/manifest.json
NUNTI_GENERATION_INITIAL_LIMIT=20
NUNTI_GENERATION_VOICE_CAPACITY=30
NUNTI_GENERATION_JOB_CAP_MICROS=300000
NUNTI_GENERATION_TOTAL_CAP_MICROS=6000000
# Never open paid execution until every step ceiling is verified with the account.
NUNTI_GENERATION_PRICES_VERIFIED=false
NUNTI_GENERATION_STEP_CEILINGS_MICROS={}
# API credentials are environment variables only; do not add values to this file.
# OPENAI_API_KEY, ELEVENLABS_API_KEY, GOOGLE_API_KEY, RECRAFT_API_TOKEN
