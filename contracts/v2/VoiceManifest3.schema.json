{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nunti:contracts:v2:VoiceManifest3",
  "$defs": {
    "DesignedVoiceSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "designed-voice-v1",
          "title": "Kind",
          "type": "string"
        },
        "providerId": {
          "enum": [
            "elevenlabs-designed",
            "gemini-designed",
            "nunti-offline-fixture"
          ],
          "title": "Providerid",
          "type": "string"
        },
        "designModel": {
          "title": "Designmodel",
          "type": "string"
        },
        "synthesisModel": {
          "title": "Synthesismodel",
          "type": "string"
        },
        "voiceId": {
          "title": "Voiceid",
          "type": "string"
        },
        "bindingId": {
          "title": "Bindingid",
          "type": "string"
        },
        "specSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Specsha256",
          "type": "string"
        },
        "settingsSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Settingssha256",
          "type": "string"
        },
        "mediaOrigin": {
          "enum": [
            "PROVIDER_GENERATED",
            "OFFLINE_FIXTURE"
          ],
          "title": "Mediaorigin",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "providerId",
        "designModel",
        "synthesisModel",
        "voiceId",
        "bindingId",
        "specSha256",
        "settingsSha256",
        "mediaOrigin"
      ],
      "title": "DesignedVoiceSource",
      "type": "object"
    },
    "VoiceClip": {
      "additionalProperties": false,
      "properties": {
        "clipId": {
          "title": "Clipid",
          "type": "string"
        },
        "characterId": {
          "title": "Characterid",
          "type": "string"
        },
        "profileId": {
          "title": "Profileid",
          "type": "string"
        },
        "speakerId": {
          "title": "Speakerid",
          "type": "string"
        },
        "locale": {
          "const": "ko-KR",
          "title": "Locale",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "textSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Textsha256",
          "type": "string"
        },
        "audioPath": {
          "title": "Audiopath",
          "type": "string"
        },
        "audioSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Audiosha256",
          "type": "string"
        },
        "sampleRateHz": {
          "const": 24000,
          "title": "Sampleratehz",
          "type": "integer"
        },
        "channels": {
          "const": 1,
          "title": "Channels",
          "type": "integer"
        },
        "sampleWidthBytes": {
          "const": 2,
          "title": "Samplewidthbytes",
          "type": "integer"
        },
        "durationMs": {
          "maximum": 30000,
          "minimum": 1,
          "title": "Durationms",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/DesignedVoiceSource"
        },
        "rawAudioSha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rawaudiosha256"
        },
        "fixtureProvenance": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixtureprovenance"
        }
      },
      "required": [
        "clipId",
        "characterId",
        "profileId",
        "speakerId",
        "locale",
        "text",
        "textSha256",
        "audioPath",
        "audioSha256",
        "sampleRateHz",
        "channels",
        "sampleWidthBytes",
        "durationMs",
        "source"
      ],
      "title": "VoiceClip",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3,
      "title": "Schemaversion",
      "type": "integer"
    },
    "providerId": {
      "title": "Providerid",
      "type": "string"
    },
    "characters": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Characters",
      "type": "array"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "clips": {
      "items": {
        "$ref": "#/$defs/VoiceClip"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Clips",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "providerId",
    "characters",
    "scope",
    "clips"
  ],
  "title": "VoiceManifest3",
  "type": "object"
}
