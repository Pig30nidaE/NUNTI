{
  "$defs": {
    "LayerRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "title": "LayerRef",
      "type": "object"
    },
    "NormalizedContext": {
      "additionalProperties": false,
      "properties": {
        "destinationCategory": {
          "enum": [
            "coast",
            "mountain",
            "city",
            "nature",
            "general",
            "unknown"
          ],
          "title": "Destinationcategory",
          "type": "string"
        },
        "displayMode": {
          "enum": [
            "day",
            "night"
          ],
          "title": "Displaymode",
          "type": "string"
        },
        "mappingVersion": {
          "const": "nunti-layers-v1",
          "title": "Mappingversion",
          "type": "string"
        },
        "roadType": {
          "enum": [
            "urban",
            "highway",
            "rural",
            "mixed",
            "unknown"
          ],
          "title": "Roadtype",
          "type": "string"
        },
        "routeGeometrySource": {
          "title": "Routegeometrysource",
          "type": "string"
        },
        "routeId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Routeid"
        },
        "routePointCount": {
          "title": "Routepointcount",
          "type": "integer"
        },
        "routeRevision": {
          "title": "Routerevision",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "string"
        },
        "userSelectedMood": {
          "enum": [
            "calm",
            "curious",
            "adventurous",
            "bright",
            "unset"
          ],
          "title": "Userselectedmood",
          "type": "string"
        }
      },
      "required": [
        "routeId",
        "routeRevision",
        "mappingVersion",
        "seed",
        "destinationCategory",
        "roadType",
        "userSelectedMood",
        "displayMode",
        "routePointCount",
        "routeGeometrySource"
      ],
      "title": "NormalizedContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
